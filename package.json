{
  "name": "tshapeplaywright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "archive:allure-results": "node -e \"const fs=require('fs'),path=require('path');const src='reports/allure-results';const dest=path.join('reports/allure-results-archive', new Date().toISOString().replace(/[:.]/g,'-'));if(fs.existsSync(src)&&fs.readdirSync(src).length){fs.mkdirSync(dest,{recursive:true});for(const f of fs.readdirSync(src))fs.renameSync(path.join(src,f),path.join(dest,f));}\"",
    "report:allure:html": "allure generate ./reports/allure-results -o ./reports/allure-html-report --clean",
    "report:html": "npx playwright show-report"
  },
"keywords": [],
